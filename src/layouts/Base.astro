---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/noto-sans-arabic';
import '@fontsource-variable/noto-naskh-arabic';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, bookingUrl, pagePath, LANGS, isLegal, type Lang, type PageKey } from '../data/site';
import { ui } from '../i18n';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Klíč stránky, která existuje ve více jazycích – řídí hreflang a přepínač jazyků. */
  pageKey?: PageKey;
  schema?: object | object[];
  noindex?: boolean;
  breadcrumbs?: { name: string; href: string }[];
}
const { title, description, lang = 'cs', pageKey, schema, noindex = false, breadcrumbs } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// cesta bez podsložky náhledu (GitHub Pages), ať sedí canonical, hreflang i zvýraznění v menu
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, '') || '/';
const canonical = new URL(path, site.url).href;
const abs = (p: string) => new URL(p, site.url).href;
const t = ui[lang];
const cs = lang === 'cs';
const altLangs = pageKey ? LANGS.filter((l) => !isLegal(pageKey) || l === 'cs' || l === 'en') : [];
const schemas = [schema ?? []].flat();
if (breadcrumbs?.length) {
  schemas.push({
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: abs(b.href) })),
  });
}
const preview = __PREVIEW__;
const bookHref = cs ? '/objednat' : bookingUrl(`${lang}-sticky`);
const ext = cs ? {} : { target: '_blank', rel: 'noopener' };
---
<!doctype html>
<html lang={lang} dir={t.dir} data-ga={import.meta.env.PROD && !preview ? site.gaId : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || preview) && <meta name="robots" content={preview ? 'noindex, nofollow' : 'noindex, follow'} />}
    {pageKey && altLangs.map((l) => <link rel="alternate" hreflang={l} href={abs(pagePath(pageKey, l))} />)}
    {pageKey && <link rel="alternate" hreflang="x-default" href={abs(pagePath(pageKey, 'cs'))} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#40304C" />
    <meta name="author" content="MUDr. Samer Asad" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs('/og-image.jpg')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', wait_for_update: 500 });
    </script>
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <ClientRouter />
  </head>
  <body>
    <Header lang={lang} pageKey={pageKey} path={path} />
    <main id="obsah"><slot /></main>
    <Footer lang={lang} />

    <nav class="sticky-cta" aria-label={t.quick}>
      <a class="btn btn-primary" href={bookHref} data-track="click_book" {...ext}>{t.book}</a>
      <a class="btn btn-outline" href={site.phoneHref} data-track="click_call" dir="ltr">{t.call}</a>
      <a class="btn btn-outline" href={site.mapsUrl} target="_blank" rel="noopener" data-track="click_map">{t.map}</a>
    </nav>

    <section class="cookie" data-cookie hidden role="dialog" aria-modal="false" aria-labelledby="cookie-title">
      <h2 id="cookie-title">{t.cookie.title}</h2>
      <p>{t.cookie.text} <a href={pagePath('cookies', lang)}>{t.cookie.more}</a></p>
      <fieldset data-cookie-settings hidden>
        <label class="checkbox"><input type="checkbox" checked disabled /> <span>{t.cookie.necessary}</span></label>
        <label class="checkbox"><input type="checkbox" name="analytics" /> <span>{t.cookie.stats}</span></label>
        <label class="checkbox"><input type="checkbox" name="marketing" /> <span>{t.cookie.marketing}</span></label>
        <button class="btn btn-outline" type="button" data-cookie-save>{t.cookie.save}</button>
      </fieldset>
      <div class="row">
        <button class="btn btn-primary" type="button" data-cookie-accept>{t.cookie.accept}</button>
        <button class="btn btn-primary" type="button" data-cookie-reject>{t.cookie.reject}</button>
        <button class="btn btn-outline" type="button" data-cookie-toggle aria-expanded="false">{t.cookie.settings}</button>
      </div>
    </section>
    <script>import '../scripts/site.ts';</script>
  </body>
</html>
