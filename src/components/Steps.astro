---
interface Props { steps: { title: string; text: string }[] }
const { steps } = Astro.props;
---
<ol class="steps">
  {steps.map((s, i) => (
    <li>
      <span class="no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <h3>{s.title}</h3>
      <p>{s.text}</p>
    </li>
  ))}
</ol>
