---
interface Crumb { name: string; href: string }
interface Props { eyebrow?: string; title: string; lead?: string; tone?: 'cream' | 'blush' | 'sage' | 'plum'; crumbs?: Crumb[]; narrow?: boolean }
const { eyebrow, title, lead, tone = 'blush', crumbs, narrow = false } = Astro.props;
const bg = { cream: '', blush: 'bg-blush', sage: 'bg-sage', plum: 'bg-plum' }[tone];
---
<section class={bg}>
  <div class={narrow ? 'wrap-narrow' : 'wrap'}>
    {crumbs && (
      <nav class="breadcrumbs" aria-label="Drobečková navigace">
        {crumbs.map((c, i) => i < crumbs.length - 1
          ? <><a href={c.href}>{c.name}</a><span aria-hidden="true">/</span></>
          : <span aria-current="page">{c.name}</span>)}
      </nav>
    )}
    <div class="page-hero split">
      <div class="stack" style="--gap:22px">
        {eyebrow && <span class="eyebrow rise">{eyebrow}</span>}
        <h1 class="h1 rise" style="--i:1">{title}</h1>
        {lead && <p class="lead rise" style="--i:2">{lead}</p>}
        <slot />
      </div>
      <slot name="aside" />
    </div>
  </div>
</section>
