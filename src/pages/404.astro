---
import Base from '../layouts/Base.astro';
---
<Base title="Stránka nenalezena | Clinic Samer" description="Požadovaná stránka neexistuje." noindex>
  <section class="wrap-narrow section stack" style="align-items:center;text-align:center;min-height:50vh;justify-content:center">
    <span class="eyebrow">Chyba 404</span>
    <h1 class="h1">Tuhle stránku jsme nenašli</h1>
    <p class="lead">Možná byla přesunuta při úpravě webu. Zkuste to z úvodní stránky nebo se rovnou objednejte.</p>
    <div class="row" style="justify-content:center">
      <a class="btn btn-primary" href="/">Zpět na úvod</a>
      <a class="btn btn-outline" href="/sluzby">Služby</a>
      <a class="btn btn-outline" href="/kontakt">Kontakt</a>
    </div>
  </section>
</Base>
