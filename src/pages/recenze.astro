---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import PageHero from '../components/PageHero.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { site } from '../data/site';
import all from '../data/reviews.json';
const reviews = [...all].sort((a, b) => b.date.localeCompare(a.date));
const crumbs = [{ name: 'Úvod', href: '/' }, { name: 'Recenze', href: '/recenze' }];
const filters = [
  { id: 'all', label: 'Všechny' },
  { id: 'gynekologie', label: 'Gynekologie' },
  { id: 'diagnostika', label: 'Diagnostika a ultrazvuk' },
  { id: 'tehotenstvi', label: 'Těhotenství' },
  { id: 'en', label: 'In English' },
];
---
<Base
  title="Recenze pacientek – MUDr. Samer Asad, gynekolog Praha 4"
  description="Ověřené recenze pacientek gynekologické ambulance MUDr. Samera Asada ze ZnámýLékař. Přečtěte si zkušenosti s vyšetřením, těhotenskou poradnou i přístupem lékaře a sestry."
  breadcrumbs={crumbs}
>
  <PageHero eyebrow="Ověřené recenze ze ZnámýLékař" title="Zkušenosti žen, které nám důvěřily" crumbs={crumbs}
    lead="Pacientky nejčastěji oceňují klidný přístup, důkladné vysvětlení a dostatek času při každé návštěvě.">
    <div slot="aside" class="info-card" style="align-self:center">
      <div class="row" style="gap:20px">
        <b class="serif" style="font-size:72px;font-weight:400;line-height:1;color:var(--color-plum-900)">4,9</b>
        <div><span class="stars" role="img" aria-label="4,9 z 5 hvězdiček">★★★★★</span><br /><span class="small muted">z 5 · více než {site.stats.reviews} ověřených recenzí</span></div>
      </div>
      <p class="small muted">Recenze sbírá a ověřuje nezávislý portál ZnámýLékař. Na profilu najdete všechna hodnocení včetně těch nejnovějších.</p>
      <a class="btn btn-outline btn-sm" href={site.zlProfile} target="_blank" rel="noopener" data-track="click_zl_reviews">Všechny recenze na ZnámýLékař</a>
    </div>
  </PageHero>

  <section class="wrap section">
    <div class="between" style="margin-bottom:32px;align-items:center">
      <div class="filters" data-filters role="group" aria-label="Filtr recenzí">
        {filters.map((f, i) => <button type="button" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>)}
      </div>
      <p class="tiny" aria-live="polite">Zobrazeno <span data-filter-count>{reviews.length}</span> z {reviews.length} vybraných recenzí</p>
    </div>
    <div class="masonry">
      {reviews.map((r) => <ReviewCard review={r} tone="blush" small showDate />)}
    </div>
    <p class="tiny" style="margin-top:16px">Citace jsou převzaty z veřejného profilu lékaře na ZnámýLékař a zveřejněny v původním znění.</p>
  </section>

  <Cta source="recenze" />
</Base>
