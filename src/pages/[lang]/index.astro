---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import Faq from '../../components/Faq.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import Ultrasound8k from '../../components/Ultrasound8k.astro';
import { site, bookingUrl, pagePath, INTL, type IntlLang } from '../../data/site';
import { dict } from '../../i18n';
import { img } from '../../data/images';
import { clinicSchema, faqSchema } from '../../data/schema';
import reviews from '../../data/reviews.json';

export const getStaticPaths = () => INTL.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as IntlLang;
const d = dict[lang], t = d.home;
const enReviews = reviews.filter((r) => r.lang === 'en');
const faq = t.faq.map(([q, a]) => ({ q, a }));
const sep = lang === 'en' ? '.' : ',';
---
<Base lang={lang} title={t.title} description={t.description} pageKey="home" schema={[clinicSchema, faqSchema(faq)]}>
  <section class="wrap split" style="padding-block:clamp(40px,6vw,72px) clamp(56px,7vw,88px);gap:64px">
    <div class="stack" style="--gap:28px">
      <span class="chip chip-sage rise"><span class="dot dot-live" aria-hidden="true"></span>{t.badge}</span>
      <h1 class="display rise" style="--i:1">{t.h1} <em>{t.h1em}</em></h1>
      <p class="lead rise" style="--i:2">{t.lead}</p>
      <div class="row rise" style="--i:2">
        <a class="btn btn-primary" data-magnetic href={bookingUrl(`${lang}-hero`)} target="_blank" rel="noopener" data-track="click_book">{t.bookFirst}</a>
        <a class="btn btn-outline" href={site.phoneHref} data-track="click_call">{site.phone}</a>
      </div>
      <p class="tiny rise" style="--i:3">{t.place} · {d.languages.join(' · ')}</p>
    </div>
    <div class="hero-photo rise" style="--i:1">
      <div class="blob" aria-hidden="true"></div>
      <div class="photo photo-arch hero-art" data-parallax>
        <Image src={img.heroArt} alt={t.heroAlt} widths={[440, 660, 880]} sizes="(max-width: 900px) 80vw, 440px" loading="eager" fetchpriority="high" />
      </div>
      <a class="badge" href={site.zlProfile} target="_blank" rel="noopener"><b dir="ltr">4{sep}9 / 5</b><span>{t.ratingText}</span></a>
    </div>
  </section>

  <section class="bg-blush">
    <div class="wrap stats" style="padding-block:48px">
      <div class="stat"><b dir="ltr" data-count={site.stats.years} data-suffix="+">20+</b><span>{t.stats[0]}</span></div>
      <div class="stat"><b dir="ltr" data-count={site.stats.reviews} data-suffix="+">700+</b><span>{t.stats[1]}</span></div>
      <div class="stat"><b dir="ltr" data-count={site.stats.rating} data-decimals="1" data-sep={sep} data-suffix=" / 5">4{sep}9 / 5</b><span>{t.stats[2]}</span></div>
      <div class="stat"><b dir="ltr" data-count="5">5</b><span>{t.stats[3]}</span></div>
    </div>
  </section>

  <section class="wrap section">
    <div class="between" style="margin-bottom:40px" data-reveal>
      <div class="stack" style="--gap:12px;max-width:640px"><span class="eyebrow">{t.careEyebrow}</span><h2 class="h2">{t.careTitle}</h2></div>
      <a class="link-arrow" href={pagePath('services', lang)}>{d.ui.allServices}</a>
    </div>
    <ServiceGrid lang={lang} />
  </section>

  <section class="bg-plum">
    <div class="wrap section split">
      <div class="photo photo-leaf-br" style="height:clamp(380px,48vw,560px)" data-reveal>
        <Image src={img.ultrasound} alt={t.doctorAlt} widths={[480, 720, 1080]} sizes="(max-width: 900px) 92vw, 540px" style="object-position:70% 55%" />
      </div>
      <div class="stack" style="--gap:24px" data-reveal>
        <span class="eyebrow">{t.doctorEyebrow}</span>
        <h2 class="h2" style="font-size:clamp(34px,4vw,52px)" dir="ltr">MUDr. Samer Asad</h2>
        <p class="lead">{t.doctorLead}</p>
        <div class="num-list">
          {t.values.map(([a, b], i) => <div><span class="no">{String(i + 1).padStart(2, '0')}</span><span><strong>{a}</strong> <span>{b}</span></span></div>)}
        </div>
        <a class="btn btn-light" href={pagePath('about', lang)}>{t.meet}</a>
      </div>
    </div>
  </section>

  <div style="height:clamp(64px,9vw,104px)"></div>
  <Ultrasound8k compact lang={lang} />

  <section class="wrap section">
    <div class="stack" style="--gap:12px;max-width:640px;margin-bottom:56px" data-reveal><span class="eyebrow">{t.stepsEyebrow}</span><h2 class="h2">{t.stepsTitle}</h2></div>
    <ol class="steps">
      {t.steps.map(([a, b], i) => <li><span class="no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3>{a}</h3><p>{b}</p></li>)}
    </ol>
  </section>

  <section class="bg-blush">
    <div class="wrap section">
      <div class="between" style="margin-bottom:40px" data-reveal>
        <div class="stack" style="--gap:12px"><span class="eyebrow">{t.reviewsEyebrow}</span><h2 class="h2">{t.reviewsTitle}</h2></div>
        <a class="link-arrow" href={site.zlProfile} target="_blank" rel="noopener">{t.allReviews}</a>
      </div>
      <div class="grid-auto" style="--min:320px" data-stagger>{enReviews.map((r) => <ReviewCard review={r} lang={lang} />)}</div>
    </div>
  </section>

  <section class="wrap-narrow section">
    <h2 class="h2" style="font-size:clamp(30px,3.6vw,44px);margin-bottom:32px" data-reveal>{t.faqTitle}</h2>
    <Faq items={faq} openFirst />
  </section>

  <Cta lang={lang} withContact source={`${lang}-home`} />
</Base>
