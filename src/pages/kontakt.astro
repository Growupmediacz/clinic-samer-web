---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactCard from '../components/ContactCard.astro';
import { site, insurers } from '../data/site';
import { clinicSchema } from '../data/schema';
const crumbs = [{ name: 'Úvod', href: '/' }, { name: 'Kontakt', href: '/kontakt' }];
---
<Base
  title="Kontakt – gynekolog Praha 4 Braník | MUDr. Samer Asad"
  description="Gynekologická ambulance MUDr. Samera Asada: Branická 479/21, Praha 4 – Braník. Telefon +420 734 421 860, e-mail, mapa a doprava."
  pageKey="contact" schema={clinicSchema} breadcrumbs={crumbs}
>
  <PageHero eyebrow="Kontakt" title="Kde nás najdete" crumbs={crumbs} tone="sage"
    lead="Ordinace sídlí v Praze 4 – Braníku. Objednat se můžete online, telefonicky nebo nám napište.">
    <div class="row">
      <a class="btn btn-primary" data-magnetic href="/objednat" data-track="click_book">Objednat se online</a>
      <a class="btn btn-light" href={site.phoneHref} data-track="click_call">{site.phone}</a>
    </div>
    <ContactCard slot="aside" mapHeight={260} />
  </PageHero>

  <section class="wrap section">
    <div class="grid-auto" style="--min:280px" data-stagger>
      <div class="card card-blush stack" style="--gap:8px">
        <h2 class="h3">Tramvají a autobusem</h2>
        <p class="small muted">Nejbližší zastávka MHD je <strong>Braník</strong>, odkud je to do ordinace pár minut pěšky. Spojení si můžete vyhledat na <a href="https://pid.cz/" target="_blank" rel="noopener">pid.cz</a>.</p>
      </div>
      <div class="card card-blush stack" style="--gap:8px">
        <h2 class="h3">Autem</h2>
        <p class="small muted">Adresa pro navigaci: {site.street}, {site.zip} Praha 4. <a href={site.mapsUrl} target="_blank" rel="noopener" data-track="click_map">Otevřít v Mapách Google</a>. Na možnosti parkování se zeptejte při objednání.</p>
      </div>
      <div class="card card-blush stack" style="--gap:8px">
        <h2 class="h3">Jazyky</h2>
        <p class="small muted">V ordinaci se domluvíte {site.languages.cs.slice(0, -1).join(', ')} a {site.languages.cs.at(-1)}. <a href="/en/contact" hreflang="en">Contact in English</a></p>
      </div>
      <div class="card card-blush stack" style="--gap:8px">
        <h2 class="h3">Pojišťovny</h2>
        <p class="small muted">{insurers.map((i) => i.short).join(' · ')}. <a href="/cenik">Ceník a úhrady</a></p>
      </div>
    </div>
  </section>
</Base>
