# Apache / LiteSpeed (Hostinger): HTTPS, bez www, URL bez koncového lomítka, 301 starých URL, cache
Options -Indexes
DirectorySlash Off
RewriteEngine On

RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Staré jazykové mutace z původního jednostránkového webu
RewriteRule ^cz/?$ / [L,R=301]
# Právní stránky jsou jen česky a anglicky
RewriteRule ^de/datenschutz/?$ /en/privacy [L,R=301]
RewriteRule ^(it|ar)/privacy/?$ /en/privacy [L,R=301]
RewriteRule ^(de|it|ar)/cookies/?$ /en/cookies [L,R=301]

# Kanonické URL jsou bez koncového lomítka: /sluzby/ → /sluzby
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /$1 [L,R=301]
# /sluzby → sluzby/index.html (bez přesměrování)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Soubory s hashem v názvu mají vlastní pravidlo v _astro/.htaccess
  <FilesMatch "\.(webp|avif|jpg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
